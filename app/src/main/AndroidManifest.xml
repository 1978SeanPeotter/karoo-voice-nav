<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets the app see whether a text-to-speech engine is installed (Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.speech.tts.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- This is what makes it a Karoo extension: Karoo finds and runs this service. -->
        <service
            android:name=".VoiceNavExtension"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="io.hammerhead.karooext.KAROO_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="io.hammerhead.karooext.EXTENSION_INFO"
                android:resource="@xml/extension_info" />
        </service>

        <!-- Where the Karoo checks for updates. Replaced by the build with your repo's URL. -->
        <meta-data
            android:name="io.hammerhead.karooext.MANIFEST_URL"
            android:value="@string/manifest_url" />
    </application>
</manifest>
